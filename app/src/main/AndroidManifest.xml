<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET permission: app is 100% offline -->
    <application
        android:name=".RollaApp"
        android:label="RollaMusicPlayer"
        android:theme="@style/Theme.RollaMusicPlayer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link into Search (rollamusic://search[?query=...]), handled by the
                 composable<Search> destination's navDeepLink<Search> in MainActivity's NavHost. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rollamusic" android:host="search" />
            </intent-filter>
        </activity>
    </application>
</manifest>
