<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's note (Phase 7 ruling 4), also its monochrome layer: RollaIcons.MusicNote's path, as transcribed in
  :feature:widget's widget_ic_music_note.xml, with every coordinate scaled by 108/24 onto the 108 dp adaptive-icon
  canvas and the stroke likewise (2.0 × 108/24 = 9), round caps and joins, no fill. The group then scales the whole
  24-unit icon box (108 units) into the 66 dp safe zone (66/108), about the canvas centre, so the launcher's mask never
  cuts the note.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.6111111"
        android:scaleY="0.6111111">
        <path
            android:pathData="M54.9,76.5 A14.4,14.4 0 0,1 26.1,76.5 A14.4,14.4 0 0,1 54.9,76.5 Z
                M54.9,76.5 L54.9,22.5 C69.75,22.5 78.75,32.4 78.75,45.9"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="9" />
    </group>
</vector>
