filters:
  and:
    - type == "decision"
views:
  - type: table
    name: Active decisions
    filters:
      and:
        - status == "active"
    order:
      - file.name
      - date
      - tags
      - source
  - type: table
    name: Superseded
    filters:
      and:
        - status == "superseded"
    order:
      - file.name
      - date
      - superseded_by
