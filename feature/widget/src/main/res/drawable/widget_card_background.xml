<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget card (spec §13, Phase 6c ruling 6): true black (@color/widget_card) with 24 dp corners, the device's own
  system widget radius. A shape drawable is rounded on every API this app supports (minSdk 24); the root also adds
  GlanceModifier.cornerRadius(RollaDimens.widgetCardRadius), which clips on API 31+ and is ignored below. The colour
  comes from the widget palette (res/values/colors.xml), which WidgetPaletteTest keeps equal to MusicWidgetTheme.kt.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_card" />
    <corners android:radius="24dp" />
</shape>
