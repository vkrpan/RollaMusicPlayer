<?xml version="1.0" encoding="utf-8"?>
<!--
  Skip back 15 s, a widget-only line icon: per the Phase 1 ruling it ships with the widget as XML, not in RollaIcons,
  because no Compose screen uses it (Phase 6c ruling 5). Stroke 1.6 with round caps and joins, no fill, like the
  RollaIcons line set.
  - Ring: centre (12, 13), radius 7.5, drawn clockwise from the top for 300 degrees, so it is open between ten o'clock
    and the top. The arrowhead's tip sits at the top (12, 5.5) and points left: the motion is counter-clockwise.
  - Numerals "15": strokes kept inside the box x 8-16, y 9-16 (outer stroke edge included).
  widget_ic_skip_forward_15 mirrors the ring about x = 12 and keeps these numerals as they are. White, tinted at the call
  site. WidgetIconParityTest pins the mirror and the upright numerals.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Ring and arrowhead. -->
    <path
        android:pathData="M12,5.5 A7.5,7.5 0 1,1 5.5048,9.25
            M13.84,3.96 L12,5.5 L13.84,7.04"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />
    <!-- Numerals "15". -->
    <path
        android:pathData="M9.2,10.9 L10.3,9.8 L10.3,15.1
            M15,9.8 L12.9,9.8 L12.7,12.1 C13.1,11.85 13.55,11.75 13.95,11.75 C14.6,11.75 15,12.35 15,13.4
            C15,14.5 14.45,15.1 13.75,15.1 C13.25,15.1 12.85,14.9 12.6,14.55"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.6" />
</vector>
