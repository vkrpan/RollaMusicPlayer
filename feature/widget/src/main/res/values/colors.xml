<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget-local color palette: the single source of truth for both the Glance
  `ColorProviders` (MusicWidgetTheme.kt) and the rounded-card background drawable
  (drawable/widget_card_background.xml).

  Glance composes OUTSIDE `RollaMusicPlayerTheme`, so the widget cannot read the app's
  `LocalRollaDarkTheme`-driven semantic tokens (`miniPlayerContainer`, `sliderInactiveTrack`,
  etc.; see :core:designsystem). Per ui-style-guide.md §8, the widget mirrors the dark
  mini-player look UNCONDITIONALLY (day == night, both dark) rather than following the
  system/app theme, so these are plain (non-night-qualified) values mapped 1:1 from
  ui-style-guide.md §2's dark-theme role table.
-->
<resources>
    <!-- §2 surfaceContainer: the rounded widget card itself. -->
    <color name="widget_surface_container">#FF1C1C1E</color>
    <!-- §2 surfaceContainerHigh: artwork placeholder tile behind the music-note glyph. -->
    <color name="widget_surface_container_high">#FF2A2A2C</color>
    <!-- §2 onSurface: title text, control icon tint. -->
    <color name="widget_on_surface">#FFFFFFFF</color>
    <!-- §2 onSurfaceVariant: artist text (secondary label). -->
    <color name="widget_on_surface_variant">#FF9CA0A6</color>
    <!-- §2 primary (dark): the one stable accent — progress fill, play glyph emphasis.
         Synced 2026-07-15 with the WCAG-audit token split in :core:designsystem (was #3D7BFF). -->
    <color name="widget_primary">#FF4780FF</color>
    <!-- §2 onPrimary (dark): unused by this layout but kept 1:1 with the app scheme (was #FFFFFF). -->
    <color name="widget_on_primary">#FF001B3F</color>
    <!-- §2 primaryContainer: unused by this layout but required by ColorProviders' role set. -->
    <color name="widget_primary_container">#FF1E3A66</color>
    <!-- §2 sliderInactiveTrack (dark): the progress bar's inactive track. Raised with the WCAG
         audit (was #3A3A3C, only 1.50:1 vs the card) — #6E6E73 clears the 3:1 component floor. -->
    <color name="widget_track">#FF6E6E73</color>
    <!-- §2 outlineVariant: unused hairline role, kept for ColorProviders completeness. -->
    <color name="widget_outline_variant">#FF2C2C2E</color>
    <!-- §2 error: unused by this layout but required by ColorProviders' role set. -->
    <color name="widget_error">#FFFF5A5A</color>
</resources>
