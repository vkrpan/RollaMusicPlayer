<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget-local colour palette (Phase 6c ruling 4, spec §13), read by the drawables (card background, artwork
  placeholder, picker preview). MusicWidgetTheme.kt holds the same values as Kotlin constants for the Glance
  ColorProviders; WidgetPaletteTest keeps the two equal.

  Glance composes outside the app's Compose theme, so the widget cannot read the app's colour tokens; spec §5.1
  exempts widget* colours from the design-system palette. The widget is dark whatever the system theme
  (day == night), so these are plain values with no night-qualified copy.
-->
<resources>
    <!-- The card: true black. Glance roles surface, background, surfaceContainer*, inverseOnSurface. -->
    <color name="widget_card">#FF000000</color>
    <!-- Title text and control glyph tint, 20.49:1 on the card. Roles onSurface, onBackground, onPrimary*,
         onError, inverseSurface. -->
    <color name="widget_title">#FFFCFCFE</color>
    <!-- Artist text, 9.70:1 on the card. Role onSurfaceVariant. -->
    <color name="widget_artist">#FFB0B0B2</color>
    <!-- The one accent: progress fill, 4.65:1 on the card. Roles primary, secondary, tertiary, inversePrimary. -->
    <color name="widget_accent">#FF2F6FF0</color>
    <!-- Progress track, 3.56:1 on the card (ruling 1: the app's dark sliderInactiveTrack, not spec §13's #333333,
         which only reaches 1.66:1). Role surfaceVariant. -->
    <color name="widget_track">#FF646466</color>
    <!-- Artwork placeholder box behind the white note (note 11.79:1 on it). Roles *Container. -->
    <color name="widget_art_placeholder">#FF363636</color>
    <!-- Unused by this layout; set so no Glance role falls back to a Material default. Role error. -->
    <color name="widget_error">#FFFF5A5A</color>
</resources>
